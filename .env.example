# ==============================================================================
# AdaptIQ Environment Configuration
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGO_URI=mongodb://127.0.0.1:27017/adaptiq
MONGO_TEST_URI=mongodb://127.0.0.1:27017/adaptiq_test

# Authentication (JWT)
JWT_SECRET=super_secure_jwt_secret_key_adaptiq_2026_dev_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secure_refresh_secret_key_adaptiq_2026_dev_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# LLM Provider Configuration
# Supported providers: gemini (default), openai, claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Alternative LLM Keys (if swapped via server/src/services/llm/index.js)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Speech-to-Text (Whisper API via OpenAI or Groq)
WHISPER_PROVIDER=groq
WHISPER_API_KEY=your_whisper_or_groq_api_key_here

# Code Execution (Judge0 REST API)
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=

# File Uploads & Temp Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
