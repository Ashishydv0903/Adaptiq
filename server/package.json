{
  "name": "adaptiq-server",
  "version": "1.0.0",
  "description": "AdaptIQ Backend - Adaptive Assessment & XAI Scoring Engine",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "report:false-positives": "node src/scripts/reportFalsePositiveRates.js",
    "test:ml": "cross-env NODE_OPTIONS=--experimental-vm-modules jest src/tests/ml --runInBand",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "@google/generative-ai": "^0.15.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "graphology": "^0.25.4",
    "graphology-traversal": "^0.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "ml-matrix": "^6.11.1",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.6.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^22.12.1",
    "simple-statistics": "^7.8.7",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/src/tests/**/*.test.js"
    ],
    "verbose": true,
    "collectCoverageFrom": [
      "src/ml/**/*.js",
      "src/services/**/*.js"
    ]
  }
}
